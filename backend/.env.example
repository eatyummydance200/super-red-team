# Set these in the backend process environment; never send them to a runner.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ZAI_API_KEY=
MODEL_A=deepseek-flash
MODEL_B=qwen3.8-flash
MODEL_C=glm-5.3-flash
MODEL_A_BASE_URL=https://api.deepseek.com
MODEL_B_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
MODEL_C_BASE_URL=https://api.z.ai/api/paas/v4
MODEL_CALL_TIMEOUT=60
# Gemini alternative (both models share GEMINI_API_KEY):
# MODEL_A=gemini/gemini-3.6-flash
# MODEL_B=gemini/gemini-3.5-flash-lite
# Enter current provider rates per million tokens. Empty = unknown cost.
MODEL_A_INPUT_USD_PER_MILLION=
MODEL_A_OUTPUT_USD_PER_MILLION=
MODEL_B_INPUT_USD_PER_MILLION=
MODEL_B_OUTPUT_USD_PER_MILLION=
MODEL_C_INPUT_USD_PER_MILLION=
MODEL_C_OUTPUT_USD_PER_MILLION=
# Local API bearer credential, separate from model keys. Required for public hosting.
BACKEND_API_TOKEN=
REQUIRE_API_AUTH=false
CORS_ALLOWED_ORIGINS=https://super-red-team-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=data
LITELLM_LOCAL_MODEL_COST_MAP=True
# Optional operator-owned web target registry. The app does not auto-load .env.
REDTEAM_TARGETS_FILE=
PAPER_CUP_USER_A=
PAPER_CUP_PASSWORD_A=
PAPER_CUP_USER_B=
PAPER_CUP_PASSWORD_B=
